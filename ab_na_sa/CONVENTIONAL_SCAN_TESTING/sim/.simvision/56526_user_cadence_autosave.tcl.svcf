
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set toolbar-SimControl-WaveWindow {
  usual
  position -anchor e
}
preferences set cursorctl-dont-show-sync-warning 1
preferences set toolbar-sendToIndago-WaveWindow {
  usual
  position -pos 1
}
preferences set toolbar-Standard-Console {
  usual
  position -pos 1
}
preferences set toolbar-Search-Console {
  usual
  position -pos 2
}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 1920x977+-1+27}] != ""} {
    window geometry "Design Browser 1" 1920x977+-1+27
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  simulator::tb_conventional 
browser set \
    -signalsort name
browser yview see  simulator::tb_conventional 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1920x977+-1+27}] != ""} {
    window geometry "Waveform 1" 1920x977+-1+27
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	simulator::tb_conventional.ENERGY_PER_TRANSITION
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.TOTAL_FAULTS
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.WIDTH
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.activity[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.activity_delta[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.actual_y
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.b
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.clk
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.coverage[7:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.csv_fd
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.detected_faults[7:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.detected_map[19:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.energy[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.energy_increment[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.f
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.fault_detected
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.fault_enable
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.fault_index[4:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.golden_y
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.p
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.patterns_run
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.reset
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.response_valid
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.result_fd
	} ]
set id [waveform add -signals  {
	{simulator::tb_conventional.scan_data[7:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.scan_enable
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.scan_in
	} ]
set id [waveform add -signals  {
	simulator::tb_conventional.scan_out
	} ]

waveform xview limits 29787ns 34191ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 1920x977+-1+27

#
# Layout selection
